*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.flac
*.pdf
*.psd
*.tif
*.tiff
*.svg

# Local environment and secrets
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
*.secret
credentials.json
secrets/

# Operating system files
.DS_Store
Thumbs.db

# Editors and local tooling
.vscode/
.idea/
*.swp
*.swo

# Temporary and local caches
cache/
.tmp/
.temp/
logs/
